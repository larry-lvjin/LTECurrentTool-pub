<Window x:Class="LTECurrentTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LTECurrentTool"
        mc:Ignorable="d"
        Title="LTE电流自动化测试 V3.7" Height="700" Width="1200"
        Background="#FF000000"
        Foreground="#FFFFFFFF"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ConnectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4169E1"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF4169E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5A7FE1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF32CD32"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF32CD32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF42DD42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PauseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFA500"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFFFA500"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFBB500"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFF6347"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFFF6347"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFF7357"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF9370DB"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF9370DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFA380EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小号圆角按钮：ALL(绿) / NONE(蓝灰) -->
        <Style x:Key="BandAllButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2FA84F"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF37BE5B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BandNoneButtonStyle" TargetType="Button" BasedOn="{StaticResource BandAllButtonStyle}">
            <Setter Property="Background" Value="#FF4C6B7B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5B7E90"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TechTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TechComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 黑底白字可编辑下拉框（用于 CMW500 地址等） -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E5DCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkEditableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="MainBorder" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>

                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="#FFFFFFFF"
                                     SelectionBrush="#FF1E5DCC"
                                     BorderThickness="0"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Focusable="True"/>

                            <ToggleButton Grid.Column="1"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#FFFFFFFF"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="#FF000000"
                                            BorderBrush="#FF555555"
                                            BorderThickness="1"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF888888"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF4169E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TechDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FF333333"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FF333333"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="#FF1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#FF2A2A2A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF3A3A3A"/>
                        <Setter Property="Foreground" Value="#FF4169E1"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="BorderBrush" Value="#FF555555"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TechGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 设备连接区域 -->
        <GroupBox Header="⚡ 设备连接" Grid.Row="0" Style="{StaticResource TechGroupBoxStyle}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="CMW500 地址:" VerticalAlignment="Center" Margin="3" FontSize="12"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbCmwIp" Margin="3" IsEditable="True" Style="{StaticResource DarkEditableComboBoxStyle}" Height="24" SelectedIndex="0" Text="TCPIP0::192.0.2.10::INSTR">
                    <ComboBoxItem Content="TCPIP0::192.0.2.10::INSTR"/>
                    <ComboBoxItem Content="TCPIP0::192.0.2.10::INSTR"/>
                </ComboBox>
                <Button Grid.Row="0" Grid.Column="2" x:Name="btnConnectCmw" Content="🔌 连接CMW500" Height="24"
                        Click="BtnConnectCmw_Click" Margin="3" Style="{StaticResource ConnectButtonStyle}" FontSize="12"/>
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtCmwStatus" Text="● 未连接"
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FFFF4444" FontWeight="Bold" FontSize="12"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="电源:" VerticalAlignment="Center" Margin="3" FontSize="12"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbPowerSource" Margin="3" Height="24" SelectedIndex="0"
                          IsEditable="True" IsReadOnly="True" Style="{StaticResource DarkEditableComboBoxStyle}" >
                    <ComboBoxItem Content="66319D（GPIB0::5::INSTR）"/>
                    <ComboBoxItem Content="电池"/>
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="2" x:Name="btnConnectPower" Content="🔌 连接电源" Height="24"
                        Click="BtnConnectPower_Click" Margin="3" Style="{StaticResource ConnectButtonStyle}" FontSize="12"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtPowerStatus" Text="● 未连接"
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FFFF4444" FontWeight="Bold" FontSize="12"/>

                <!-- 测试按钮区域 + 恢复方式/COM号/自动保存位置（同一网格，保证上下两行对齐） -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="105"/>
                        <ColumnDefinition Width="*" MinWidth="105"/>
                        <ColumnDefinition Width="*" MinWidth="105"/>
                        <ColumnDefinition Width="1.6*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" x:Name="btnStartAllChannelTest" Content="▶ 高中低信道测试" Height="24"
                            Click="BtnStartAllChannelTest_Click" Margin="2" Style="{StaticResource StartButtonStyle}" FontSize="11"/>
                    <Button Grid.Row="0" Grid.Column="1" x:Name="btnStartMidChannelTest" Content="▶ 中信道测试" Height="24"
                            Click="BtnStartMidChannelTest_Click" Margin="2" Style="{StaticResource StartButtonStyle}" FontSize="11"/>
                    <Button Grid.Row="0" Grid.Column="2" x:Name="btnStopTest" Content="⏹ 停止测试" Height="24"
                            Click="BtnStopTest_Click" Margin="2" IsEnabled="False" Style="{StaticResource StopButtonStyle}" FontSize="11"/>
                    <Button Grid.Row="1" Grid.Column="0" x:Name="btnPauseTest" Content="⏸ 暂停测试" Height="24"
                            Click="BtnPauseTest_Click" Margin="2" IsEnabled="False" Style="{StaticResource PauseButtonStyle}" FontSize="11"/>
                    <Button Grid.Row="1" Grid.Column="1" x:Name="btnExportResults" Content="💾 导出结果" Height="24"
                            Click="BtnExportResults_Click" Margin="2" Style="{StaticResource ExportButtonStyle}" FontSize="11"/>
                    <Button Grid.Row="1" Grid.Column="2" x:Name="btnAutoSaveFolder" Content="📁 自动保存位置" Height="24"
                            Click="BtnAutoSaveFolder_Click" Margin="2" Style="{StaticResource ExportButtonStyle}" FontSize="11"
                            ToolTip="选择测试结果自动保存的文件夹"/>

                    <!-- RRC未连接时的恢复方式 + AT口COM号 -->
                    <Grid Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="cmbRecoveryMode" Height="24" Margin="2" SelectedIndex="1"
                                  IsEditable="True" IsReadOnly="True" Style="{StaticResource DarkEditableComboBoxStyle}">
                            <ComboBoxItem Content="电源控制"/>
                            <ComboBoxItem Content="AT控制"/>
                        </ComboBox>
                        <TextBlock Grid.Column="1" Text="COM:" VerticalAlignment="Center" Margin="8,2,2,2" FontSize="12"/>
                        <TextBox Grid.Column="2" x:Name="txtAtComPort" Width="42" Height="24" Margin="2" Style="{StaticResource TechTextBoxStyle}"
                                 Padding="4,0" VerticalContentAlignment="Center" FontSize="12"
                                 TextChanged="TxtAtComPort_TextChanged" ToolTip="样机AT口的COM号，只填数字，如 3"/>
                        <Button Grid.Column="3" x:Name="btnDshNotificationSettings" Height="24" Width="24" Margin="2"
                                Click="BtnDshNotificationSettings_Click" Style="{StaticResource ConnectButtonStyle}"
                                FontFamily="Segoe MDL2 Assets" FontSize="15" Content="&#xE713;"
                                ToolTip="DSH 微信通知设置" AutomationProperties.Name="DSH 微信通知设置"/>
                    </Grid>

                    <!-- 结果自动保存位置 -->
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtAutoSaveFolder" Height="24" Margin="12,2,2,2"
                             VerticalAlignment="Center" Style="{StaticResource TechTextBoxStyle}"
                             Padding="4,0" VerticalContentAlignment="Center" FontSize="12"
                             Text="D:\LTE-current-testreport" LostFocus="TxtAutoSaveFolder_LostFocus"
                             ToolTip="测试结果自动保存的文件夹，可直接编辑或点击“自动保存位置”按钮选择"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 测试控制区域 -->
        <GroupBox Header="🎮 测试控制" Grid.Row="1" Style="{StaticResource TechGroupBoxStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：TPPC 和 ULRB -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,20,0">
                    <!-- 第一行：TPPC -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="TPPC:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" FontWeight="Bold" Foreground="#FF4169E1" Width="50"/>
                        <CheckBox x:Name="chkTpcMin" Content="MIN" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" VerticalAlignment="Center" FontSize="10"/>
                        <CheckBox x:Name="chkTpc0" Content="0" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" VerticalAlignment="Center" FontSize="10"/>
                        <CheckBox x:Name="chkTpc10" Content="10" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" VerticalAlignment="Center" FontSize="10"/>
                        <CheckBox x:Name="chkTpc15" Content="15" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" VerticalAlignment="Center" FontSize="10"/>
                        <CheckBox x:Name="chkTpcMax" Content="MAX" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" VerticalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ULRB:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" FontWeight="Bold" Foreground="#FF4169E1" Width="50"/>
                        <CheckBox x:Name="chkUlrb12" Content="12" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" VerticalAlignment="Center" FontSize="10"/>
                        <CheckBox x:Name="chkUlrb50" Content="50" IsChecked="True" Margin="10,0" Foreground="#FFFFFFFF" VerticalAlignment="Center" FontSize="10"/>
                    </StackPanel>

                    <!-- 第二行：ULRB -->
                </StackPanel>

                <!-- 中间：BAND 选择 -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,20,0">
                    <!-- 第一行：FDD BAND (部分) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="BAND:" FontSize="11" FontWeight="Bold" Foreground="#FF4169E1" Margin="0,0,8,0" VerticalAlignment="Center" Width="50"/>
                        <CheckBox x:Name="chkB1" Content="B1" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB2" Content="B2" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB3" Content="B3" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB4" Content="B4" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB5" Content="B5" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB7" Content="B7" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB8" Content="B8" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB12" Content="B12" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB13" Content="B13" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                    </StackPanel>

                    <!-- 第二行：FDD BAND (续) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="FDD:" FontSize="11" FontWeight="Bold" Foreground="#FF4169E1" Margin="0,0,8,0" VerticalAlignment="Center" Width="50"/>
                        <CheckBox x:Name="chkB17" Content="B17" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB18" Content="B18" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB19" Content="B19" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB20" Content="B20" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB25" Content="B25" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB26" Content="B26" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB28" Content="B28" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                        <CheckBox x:Name="chkB66" Content="B66" IsChecked="True" Margin="2,0" Foreground="#FFFFFFFF" FontSize="10"/>
                    </StackPanel>

                    <!-- 第三行：TDD BAND -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="TDD:" FontSize="11" FontWeight="Bold" Foreground="#FF4169E1" Margin="0,0,8,0" VerticalAlignment="Center" Width="50"/>
                        <CheckBox x:Name="chkB34" Content="B34" IsChecked="True" Margin="2,0" Foreground="#FFFF9900" FontSize="10"/>
                        <CheckBox x:Name="chkB38" Content="B38" IsChecked="True" Margin="2,0" Foreground="#FFFF9900" FontSize="10"/>
                        <CheckBox x:Name="chkB39" Content="B39" IsChecked="True" Margin="2,0" Foreground="#FFFF9900" FontSize="10"/>
                        <CheckBox x:Name="chkB40" Content="B40" IsChecked="True" Margin="2,0" Foreground="#FFFF9900" FontSize="10"/>
                        <CheckBox x:Name="chkB41" Content="B41" IsChecked="True" Margin="2,0" Foreground="#FFFF9900" FontSize="10"/>
                        <Button x:Name="btnBandAll" Content="ALL" Click="BtnSelectAllBands_Click"
                                Style="{StaticResource BandAllButtonStyle}" Margin="16,0,3,0" Width="39"/>
                        <Button x:Name="btnBandNone" Content="NONE" Click="BtnDeselectAllBands_Click"
                                Style="{StaticResource BandNoneButtonStyle}" Margin="10,0" Width="41"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：状态显示区域 -->
                <Border Grid.Column="2" BorderBrush="#FF555555" BorderThickness="1" CornerRadius="3"
                        Padding="15" Margin="20,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        MinWidth="200" MinHeight="60" Background="#FF1A1A1A">
                    <TextBlock x:Name="txtTestProgress" Text="⏱ 就绪"
                               FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF"
                               TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </GroupBox>

        <!-- 测试结果区域 -->
        <GroupBox Header="📊 测试结果" Grid.Row="2" Style="{StaticResource TechGroupBoxStyle}" Padding="15">
            <DataGrid x:Name="dgResults" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" IsReadOnly="True" Style="{StaticResource TechDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="BAND" Binding="{Binding BandName}" Width="60" FontWeight="Bold"/>
                    <DataGridTextColumn Header="信道类型" Binding="{Binding ChannelType}" Width="70"/>
                    <DataGridTextColumn Header="信道" Binding="{Binding Channel}" Width="70"/>
                    <DataGridTextColumn Header="TPC Setup" Binding="{Binding TPCSetup}" Width="100"/>
                    <DataGridTextColumn Header="Target Power" Binding="{Binding TargetPower}" Width="95"/>
                    <DataGridTextColumn Header="上行RB" Binding="{Binding UplinkRB}" Width="65"/>
                    <DataGridTextColumn Header="平均(mA)" Binding="{Binding MeasuredCurrent, StringFormat={}{0:F2}}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF32CD32"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="最大(mA)" Binding="{Binding MaxCurrent, StringFormat={}{0:F2}}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFFFA500"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="最小(mA)" Binding="{Binding MinCurrent, StringFormat={}{0:F2}}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF87CEEB"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="样本数" Binding="{Binding TotalSamples}" Width="70"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 日志区域 -->
        <GroupBox Header="📝 日志" Grid.Row="3" Style="{StaticResource TechGroupBoxStyle}" Padding="10" Height="180">
            <TabControl Background="#FF1A1A1A" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#FF2A2A2A"/>
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="3,3,0,0" Margin="2,0">
                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#FF4169E1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#FF3A3A3A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- 系统日志标签页 -->
                <TabItem Header="📝 系统日志">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF000000">
                        <TextBox x:Name="txtLog" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="#FF000000" Foreground="#FFFFFFFF" FontSize="11" FontFamily="Consolas"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</Window>
